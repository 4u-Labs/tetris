# Configuração de Prioridade de Execução
DirectoryIndex index.php index.html

# Redirecionamento de index.html para index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^index\.html$ index.php [R=301,L]
</IfModule>

# Sistema Anti-Cache via Headers Apache
<IfModule mod_headers.c>
    # Impede cache em arquivos dinâmicos e páginas
    <FilesMatch "\.(php|html|htm)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Evita cache persistente em scripts e estilos durante desenvolvimento
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>
